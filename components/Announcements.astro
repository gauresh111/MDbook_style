		border: 1px solid var(--t-border-strong);
		border-radius: 1.25rem;
		box-shadow: 0 24px 60px rgba(var(--t-ink-rgb), 0.45);
		animation: ann-pop 0.22s cubic-bezier(0.2, 0.9, 0.3, 1);
