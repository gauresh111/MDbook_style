	.ann-modal__cta {
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 1.1rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--t-on-accent);
		background: var(--t-accent);
		border-radius: 999px;
		text-decoration: none;
		transition: background 0.2s;
	}

	.ann-modal__cta:hover {
		background: var(--t-accent-strong);
	}

	@keyframes ann-fade {
		from {
			opacity: 0;
		}
	}

	@keyframes ann-pop {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.98);
		}
	}

	/* ---------- mobile ---------- */

	@media (max-width: 720px) {
		.ann__list {
			grid-template-columns: 1fr;
			gap: 0.7rem;
		}

		/* Matches the mobile page size of four. */
		.ann__list:not([data-ready]) > .ann__item:nth-child(n + 5) {
			display: none;
		}

		/* A pager under four cards means scrolling a screen to change page, and
		   then scrolling back to read. Lifting it next to the filters puts every
		   control in one cluster at the top, reachable without scrolling at all.
		   The list keeps its DOM position, so only the visual order moves. */
		.ann {
			display: flex;
			flex-direction: column;
		}

		.ann__filters {
			order: 1;
			margin-bottom: 0.85rem;
		}

		.ann__pager {
			order: 2;
			justify-content: space-between;
			gap: 0.4rem;
			margin: 0 0 1.1rem;
			padding-bottom: 1rem;
			border-bottom: 1px solid var(--t-border);
		}

		.ann__list,
		.ann__empty {
			order: 3;
		}

		.ann__none {
			order: 4;
		}

		/* Numbers on a phone too — going page by page through four pages to reach
		   the last one is the thing that made this tedious. The collapsing
		   1 … 4 5 6 … 12 row is what keeps them fitting. */
		.ann__pages {
			display: flex;
			gap: 0.1rem;
		}

		.ann__status {
			display: none;
		}

		/* Icon-only arrows: the labels are what would push the numbers off a
		   narrow screen, and the chevrons carry the meaning on their own. */
		.ann__nav-label {
			display: none;
		}

		.ann__nav {
			width: 2.1rem;
			padding: 0;
			justify-content: center;
		}

		/* Denser card: the summary is a teaser, and the popup holds the detail —
		   so on a phone it earns two lines, not three. */
		.ann-card {
			gap: 0.45rem;
			padding: 0.85rem 1rem;
			border-radius: 0.85rem;
		}

		.ann-card__title {
			font-size: 1rem;
		}

		.ann-card__summary {
			font-size: 0.88rem;
			line-height: 1.5;
			-webkit-line-clamp: 2;
			line-clamp: 2;
		}

		.ann-card__foot {
			padding-top: 0.15rem;
		}

		.ann-card__author,
		.ann-card__more {
			font-size: 0.78rem;
		}

		/* The lift on tap just fights the scroll window. */
		.ann-card:hover {
			transform: none;
		}

		.ann__filters {
			/* One scrolling row beats a four-line wrap on a narrow screen. */
			flex-wrap: nowrap;
			overflow-x: auto;
			scrollbar-width: none;
			margin-inline: -0.5rem;
			padding: 0.25rem 0.5rem;
