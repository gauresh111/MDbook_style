		/* Bottom sheet: thumb-reachable, and it can use the full width. */
		.ann-modal {
			align-items: flex-end;
			padding: 0;
		}

		.ann-modal__panel {
			width: 100%;
			max-height: 88vh;
			padding: 1rem 1.15rem 1.5rem;
			border-radius: 1.25rem 1.25rem 0 0;
			border-bottom: none;
			animation: ann-sheet 0.26s cubic-bezier(0.2, 0.9, 0.3, 1);
		}

		.ann-modal__grip {
			display: block;
			width: 2.5rem;
			height: 0.25rem;
			margin: 0 auto 0.9rem;
			background: var(--t-border-strong);
			border-radius: 999px;
		}

		.ann-modal__close {
			top: 0.75rem;
			right: 0.75rem;
		}

		.ann-modal__title {
			font-size: 1.25rem;
		}

		.ann-modal__cta {
			width: 100%;
			justify-content: center;
		}
	}

	@keyframes ann-sheet {
		from {
			transform: translateY(100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ann-card,
		.ann-card__more svg,
		.ann-modal__panel,
