</style>

<script>
	/**
	 * One dialog for the whole page: the card click reads the post's metadata off
	 * its data-* attributes and clones the matching build-time markdown in.
	 *
	 * Runs on every Starlight view transition, so it re-binds after navigation
	 * and only ever keeps a single dialog attached to <body>.
	 */
	/** Set once the document-level Escape handler exists, which outlives navigation. */
	let escapeBound = false;
	/** Restored when the dialog closes, so keyboard users land back on the card. */
	let lastFocused: HTMLElement | null = null;

	function closeAnnouncement() {
		const modal = document.querySelector<HTMLElement>('[data-ann-modal]');
		if (!modal || modal.hidden) return;
		modal.hidden = true;
		document.documentElement.style.overflow = '';
		modal.querySelector<HTMLElement>('[data-ann-body]')?.replaceChildren();
		lastFocused?.focus();
		lastFocused = null;
	}

	function initAnnouncements() {
		const board = document.querySelector<HTMLElement>('[data-announcements]');
		if (!board || board.dataset.annReady) return;
		board.dataset.annReady = '1';

		/* The dialog is position:fixed, so it must escape any transformed or
		   clipped ancestor in the article. Extras are dropped — the board renders
		   one dialog per instance and the page needs exactly one. */
		const dialogs = document.querySelectorAll<HTMLElement>('[data-ann-modal]');
		dialogs.forEach((node, i) => {
			if (i > 0) node.remove();
			else if (node.parentElement !== document.body) document.body.appendChild(node);
		});

		const modal = document.querySelector<HTMLElement>('[data-ann-modal]');
		if (!modal) return;

		const panel = modal.querySelector<HTMLElement>('.ann-modal__panel')!;
		const pill = modal.querySelector<HTMLElement>('[data-ann-pill]')!;
		const dateEl = modal.querySelector<HTMLElement>('[data-ann-date]')!;
		const titleEl = modal.querySelector<HTMLElement>('[data-ann-title]')!;
		const authorEl = modal.querySelector<HTMLElement>('[data-ann-author]')!;
		const bodyEl = modal.querySelector<HTMLElement>('[data-ann-body]')!;
		const footEl = modal.querySelector<HTMLElement>('[data-ann-foot]')!;
		const linkEl = modal.querySelector<HTMLAnchorElement>('[data-ann-link]')!;
		const closeBtn = modal.querySelector<HTMLElement>('.ann-modal__close')!;

		function open(card: HTMLElement) {
			const id = card.dataset.open ?? '';
			const source = document.getElementById(`ann-src-${id}`);
			const category = card.dataset.category ?? 'General';

			pill.textContent = category;
			pill.dataset.cat = category.toLowerCase();
			dateEl.textContent = card.dataset.date ?? '';
			titleEl.textContent = card.dataset.title ?? '';

			const author = card.dataset.author ?? '';
			authorEl.textContent = author ? `Posted by ${author}` : '';
			authorEl.hidden = !author;

			bodyEl.replaceChildren();
			if (source) {
				for (const child of Array.from(source.children)) {
					bodyEl.appendChild(child.cloneNode(true));
				}
			}
			bodyEl.scrollTop = 0;

			const link = card.dataset.link ?? '';
			if (link) {
				linkEl.href = link;
				linkEl.textContent = card.dataset.linkLabel || 'Open link';
			}
			footEl.hidden = !link;

			lastFocused = document.activeElement as HTMLElement | null;
			modal.hidden = false;
			/* Stops the page behind the sheet from scrolling with it. */
			document.documentElement.style.overflow = 'hidden';
			closeBtn.focus();
		}

		board.addEventListener('click', (e) => {
			const card = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
			if (card) open(card);
		});

		board.addEventListener('keydown', (e) => {
			if (e.key !== 'Enter' && e.key !== ' ') return;
			const card = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
			if (!card) return;
			e.preventDefault();
			open(card);
		});

		modal.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('[data-ann-close]')) closeAnnouncement();
		});

		if (!escapeBound) {
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') closeAnnouncement();
			});
			escapeBound = true;
		}

		/* Keeps Tab inside the sheet while it is open. */
		panel.addEventListener('keydown', (e) => {
			if (e.key !== 'Tab') return;
			const focusable = panel.querySelectorAll<HTMLElement>(
				'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
			);
			if (focusable.length === 0) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		});

		/* ---- filtering + pagination ----
		   Both narrow the same list, so they run through one draw(): the filter
		   decides which cards are eligible, the page decides which slice of those
		   is on screen. Keeping them in one place is what stops the two from
		   disagreeing — a filter that leaves 2 results while you are on page 3
		   would otherwise render an empty board. */
		const chips = board.querySelectorAll<HTMLElement>('[data-filter]');
		const items = [...board.querySelectorAll<HTMLElement>('.ann__item')];
		const noneEl = board.querySelector<HTMLElement>('.ann__none');
		const pager = board.querySelector<HTMLElement>('[data-pager]');
		const numbers = board.querySelector<HTMLElement>('[data-page-numbers]');
		const status = board.querySelector<HTMLElement>('[data-page-status]');
		const live = board.querySelector<HTMLElement>('[data-page-live]');
		const prevBtn = board.querySelector<HTMLButtonElement>('[data-page-prev]');
		const nextBtn = board.querySelector<HTMLButtonElement>('[data-page-next]');

		const phone = window.matchMedia('(max-width: 720px)');
		/* Four cards is about one screen on a phone; six is two full rows of the
		   desktop grid. */
		const pageSize = () => (phone.matches ? 4 : 6);

		let filter = '*';
		let page = 1;

		function draw(announce = false) {
			const matching = items.filter((li) => filter === '*' || li.dataset.cat === filter);
			const size = pageSize();
			const pages = Math.max(1, Math.ceil(matching.length / size));

			/* Resizing across the breakpoint, or filtering down to fewer results,
			   can strand you past the last page. */
			page = Math.min(Math.max(1, page), pages);
			const start = (page - 1) * size;

			for (const li of items) {
				const idx = matching.indexOf(li);
				li.classList.toggle('is-hidden', idx < 0 || idx < start || idx >= start + size);
			}

			if (noneEl) noneEl.hidden = matching.length > 0;
			if (pager) pager.hidden = matching.length <= size;
			if (prevBtn) prevBtn.disabled = page === 1;
			if (nextBtn) nextBtn.disabled = page === pages;
			if (status) status.textContent = `Page ${page} of ${pages}`;
			if (announce && live) {
				live.textContent = `Page ${page} of ${pages}, ${matching.length} announcements`;
			}

			if (numbers) {
				numbers.replaceChildren();
				for (const n of pageNumbers(page, pages)) {
					if (n === 0) {
						const gap = document.createElement('span');
						gap.className = 'ann__gap';
						gap.textContent = '…';
						numbers.appendChild(gap);
						continue;
					}
					const b = document.createElement('button');
					b.type = 'button';
					b.className = 'ann__page';
					b.textContent = String(n);
					b.setAttribute('aria-label', `Go to page ${n}`);
					if (n === page) b.setAttribute('aria-current', 'page');
					b.addEventListener('click', () => go(n));
					numbers.appendChild(b);
				}
			}
		}

		/* First page, last page, and a window around the current one. 0 is a gap
		   marker, so 1 … 4 5 6 … 12 stays one row however many pages there are. */
		function pageNumbers(current: number, total: number): number[] {
			if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
			const out = new Set([1, total, current, current - 1, current + 1]);
			const list = [...out].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
			const withGaps: number[] = [];
			list.forEach((n, i) => {
				if (i > 0 && n - list[i - 1] > 1) withGaps.push(0);
				withGaps.push(n);
			});
			return withGaps;
		}

		function go(n: number) {
			page = n;
			draw(true);
			/* Paging from the bottom of the list would otherwise leave you looking
			   at the pager with the new cards off-screen above. */
			if (board.getBoundingClientRect().top < 0) {
				board.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		}

		prevBtn?.addEventListener('click', () => go(page - 1));
		nextBtn?.addEventListener('click', () => go(page + 1));

		chips.forEach((chip) => {
			chip.addEventListener('click', () => {
				filter = chip.dataset.filter ?? '*';
				chips.forEach((c) => {
					const on = c === chip;
					c.classList.toggle('is-on', on);
					c.setAttribute('aria-pressed', String(on));
				});
				/* A new filter is a new list — page 3 of the old one means nothing. */
				page = 1;
				draw(true);
			});
		});

		/* The page size changes across the breakpoint, so the slice has to be
		   recomputed when the viewport crosses it. */
		phone.addEventListener('change', () => draw());

		draw();
		/* Hands slicing over from the CSS first-page fallback to draw(). */
		board.querySelector('.ann__list')?.setAttribute('data-ready', '');
	}

	initAnnouncements();
	document.addEventListener('astro:page-load', initAnnouncements);
</script>
