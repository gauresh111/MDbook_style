---
/**
 * The header of a page that fronts a downloadable document.
 *
 * The rulebook is forty pages of A4 sitting in `public/`. Handing a student a
 * bare link to it tells them nothing about what they are about to download, and
 * embedding it full-width tells them nothing either — it just spends their
 * bandwidth before they have decided they want it. So: the cover, the weight,
 * and the two things they might want to do with it, above the fold.
 *
 * The inline reader is a third choice rather than the default. This site is
 * served inside the portal's own <iframe>, so a PDF embed here is a frame
 * nested two deep — fine on a desktop browser, unreliable on mobile Safari and
 * Android Chrome. It is therefore opt-in, and the <iframe> gets no `src` until
 * the button is pressed: nothing downloads on page load.
 */
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** Path inside `public/`, with or without a leading slash. */
	file: string;
	title: string;
	/** Rendered in the eyebrow: "PDF · 40 pages · 0.9 MB". */
	pages?: number;
	/** Measured off the file at build time unless given explicitly. */
	size?: string;
	/** Edition or revision, shown against the title. */
	version?: string;
	cover: ImageMetadata;
	coverAlt?: string;
	/** Offer the in-page reader. Off for anything a student must download. */
	inline?: boolean;
}

const {
	file,
	title,
	pages,
	size,
	version,
	cover,
	coverAlt = `Cover of ${title}`,
	inline = true,
} = Astro.props;

const clean = file.replace(/^\/+/, '');

/* The site is based at /admin/courses/theme_kc, so a hand-written "/foo.pdf"
   resolves against the portal's root and 404s. Same class of bug the
   remarkMdLinks plugin in astro.config.mjs exists to fix, one layer down. */
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const href = `${base}/${clean}`;

/* Measured rather than written down. The weight is the one fact on this card a
   student acts on before clicking, and a hard-coded "11 MB" quietly becomes a
   lie the first time the file is re-exported or compressed.

   Resolved off the working directory, not `import.meta.url`: this component is
   bundled before it runs, so its own module URL points at a build chunk rather
   than at src/components/. */
function weigh(): string | undefined {
	try {
		const bytes = statSync(join(process.cwd(), 'public', clean)).size;
		const mb = bytes / 1e6;
		return mb >= 1 ? `${mb.toFixed(1)} MB` : `${Math.round(bytes / 1e3)} KB`;
	} catch {
		/* Not in public/ — a remote or generated file. Leave it off the eyebrow
		   rather than failing the build over a label. */
		return undefined;
	}
}

const facts = ['PDF', pages && `${pages} pages`, size ?? weigh()].filter(Boolean);
---

<div class="doc not-content" data-doc>
	<div class="doc__body">
		<a class="doc__cover" href={href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
			<Image src={cover} alt={coverAlt} widths={[260, 520]} sizes="160px" />
		</a>

		<div class="doc__text">
			<p class="doc__eyebrow">{facts.join(' · ')}</p>
			<h2 class="doc__title">
				{title}
				{version && <span class="doc__version">{version}</span>}
			</h2>

			<div class="doc__blurb"><slot /></div>

			<div class="doc__actions">
				<a class="doc__btn doc__btn--primary" href={href} download>
					<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><polyline points="7 11 12 16 17 11"></polyline><path d="M4 20h16"></path></svg>
					Download
				</a>

				<a class="doc__btn" href={href} target="_blank" rel="noopener">
					<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M20 4 11 13"></path><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path></svg>
					Open in new tab
				</a>

				{inline && (
					<button type="button" class="doc__btn" data-read hidden aria-expanded="false">
						<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5.5A10 10 0 0 1 12 7a10 10 0 0 1 10-1.5V19a10 10 0 0 0-10 1.5A10 10 0 0 0 2 19Z"></path><path d="M12 7v13.5"></path></svg>
						<span data-read-label>Read here</span>
					</button>
				)}
			</div>
		</div>
	</div>

	{inline && (
		<div class="doc__reader" data-reader hidden>
			{/* No src attribute: the script fills it in on first open, so the
			    file is not fetched by anyone who never asks to read it. */}
			<iframe title={title} data-frame src="about:blank" loading="lazy"></iframe>
			<p class="doc__reader-note">
				Blank or refusing to scroll? Your browser will not embed PDFs here —
				<a href={href} target="_blank" rel="noopener">open it in a new tab</a> instead.
			</p>
		</div>
	)}
</div>

<style>
.doc {
	margin: 1.5rem 0 2rem;
	border: 1px solid var(--t-border);
	border-radius: 0.75rem;
	background: rgb(var(--t-surface-2-rgb));
	overflow: hidden;
}

.doc__body {
	display: flex;
	align-items: flex-start;
	gap: 1.4rem;
	padding: 1.35rem 1.4rem;
}

/* ── Cover ──
   Duplicated by the two text links beside it, so it is out of the tab order and
   hidden from screen readers rather than announced as a third route to the same
   file. */
.doc__cover {
	position: relative;
	flex: 0 0 auto;
	inline-size: 160px;
	line-height: 0;
	border-radius: 0.35rem;
	/* The page-stack edge. Rotating a copy behind the cover would need a second
	   element; a pair of offset shadows to the right does the same job. */
	box-shadow:
		3px 0 0 -1px rgb(var(--t-surface-3-rgb)),
		4px 0 0 -1px var(--t-border),
		7px 0 0 -2px rgb(var(--t-surface-3-rgb)),
		8px 0 0 -2px var(--t-border),
		0 6px 20px rgba(0, 0, 0, 0.22);
	transition: transform 0.2s ease;
}

.doc__cover:hover {
	transform: translateY(-2px);
}

.doc__cover img {
	inline-size: 100%;
	block-size: auto;
	border: 1px solid var(--t-border);
	border-radius: 0.35rem;
}

/* ── Text column ── */
.doc__text {
	flex: 1;
	min-inline-size: 0;
}

.doc__eyebrow {
	margin: 0 0 0.3rem;
	font-family: var(--t-font-mono);
	font-size: 0.72rem;
	letter-spacing: 0.04em;
	text-transform: uppercase;
	color: var(--t-text-faint);
}

.doc__title {
	display: flex;
	align-items: baseline;
	flex-wrap: wrap;
	gap: 0.55rem;
	margin: 0 0 0.5rem;
	font-family: var(--t-font-heading);
	font-size: 1.35rem;
	font-weight: 600;
	line-height: 1.25;
	color: var(--t-text-strong);
}

.doc__version {
	padding: 0.1rem 0.45rem;
	border: 1px solid rgba(var(--t-accent-rgb), 0.4);
	border-radius: 0.3rem;
	background: rgba(var(--t-accent-rgb), 0.12);
	font-family: var(--t-font-mono);
	font-size: 0.7rem;
	font-weight: 500;
	color: var(--t-accent);
}

.doc__blurb {
	margin-block-end: 1rem;
	font-size: 0.92rem;
	line-height: 1.6;
	color: var(--t-text);
}

.doc__blurb :global(p) {
	margin: 0 0 0.5rem;
}

.doc__blurb :global(p:last-child) {
	margin-block-end: 0;
}

/* ── Actions ── */
.doc__actions {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem;
}

.doc__btn {
	display: inline-flex;
	align-items: center;
	gap: 0.4rem;
	padding: 0.42rem 0.8rem;
	border: 1px solid var(--t-border);
	border-radius: 0.4rem;
	background: rgb(var(--t-surface-rgb));
	font-family: var(--t-font-heading);
	font-size: 0.82rem;
	font-weight: 500;
	color: var(--t-text);
	text-decoration: none;
	cursor: pointer;
	transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
}

.doc__btn:hover {
	border-color: var(--t-accent);
	color: var(--t-accent);
}

.doc__btn--primary {
	border-color: var(--t-accent);
	background: var(--t-accent);
	color: var(--t-on-accent);
}

.doc__btn--primary:hover {
	background: var(--t-accent-strong);
	border-color: var(--t-accent-strong);
	color: var(--t-on-accent);
}

/* ── Inline reader ── */
.doc__reader {
	border-block-start: 1px solid var(--t-border);
	background: rgb(var(--t-surface-3-rgb));
}

.doc__reader iframe {
	display: block;
	inline-size: 100%;
	/* Tall enough to hold a full A4 page at a readable width, capped so the
	   reader never grows past the viewport and swallows the page scroll. */
	block-size: min(80vh, 900px);
	border: 0;
}

.doc__reader-note {
	margin: 0;
	padding: 0.5rem 0.9rem;
	border-block-start: 1px solid var(--t-border);
	font-size: 0.78rem;
	color: var(--t-text-muted);
}

@media (max-width: 34rem) {
	.doc__body {
		flex-direction: column;
		gap: 1rem;
	}

	.doc__cover {
		inline-size: 116px;
	}

	.doc__btn {
		flex: 1 1 auto;
		justify-content: center;
	}
}

@media (prefers-reduced-motion: reduce) {
	.doc__cover {
		transition: none;
	}
}
</style>

<script>
	/**
	 * The reader is revealed by script, so a student without JavaScript never
	 * sees a button that cannot open anything — the download and new-tab links
	 * beside it are plain anchors and work regardless.
	 */
	function initDoc(root: HTMLElement) {
		const button = root.querySelector<HTMLButtonElement>('[data-read]');
		const reader = root.querySelector<HTMLElement>('[data-reader]');
		const frame = root.querySelector<HTMLIFrameElement>('[data-frame]');
		const label = root.querySelector<HTMLElement>('[data-read-label]');
		const source = root.querySelector<HTMLAnchorElement>('a[download]');
		if (!button || !reader || !frame || !source) return;

		button.hidden = false;

		button.addEventListener('click', () => {
			const opening = reader.hidden;

			/* Set once. Re-assigning src on every toggle would refetch the file
			   and throw away the reader's scroll position mid-lookup. */
			if (opening && frame.src.endsWith('about:blank')) {
				frame.src = source.href;
			}

			reader.hidden = !opening;
			button.setAttribute('aria-expanded', String(opening));
			if (label) label.textContent = opening ? 'Hide reader' : 'Read here';
		});
	}

	function initDocs() {
		for (const root of document.querySelectorAll<HTMLElement>('[data-doc]')) {
			if (root.dataset.docInit) continue;
			root.dataset.docInit = '1';
			initDoc(root);
		}
	}

	initDocs();
	document.addEventListener('astro:page-load', initDocs);
</script>
