---
/**
 * Task 0 as one journey through two territories.
 *
 * The thing missing from these pages was never detail — it was the shape. A
 * student could read all nine of them and still not know that the work happens
 * on their own machine while the marks are recorded somewhere else entirely.
 * Nothing is uploaded on this site. That boundary is the most important fact
 * about Task 0's flow, so here it is a place you can see yourself crossing,
 * rather than a sentence on the fifth page.
 *
 * Each stop says what you do and why it matters. The why is the part a
 * reference manual leaves out and the part that makes a step stick.
 *
 * Motion follows the homepage story rail: reveal on scroll, and a line that
 * fills as you pass. One rail per band rather than one for the whole journey —
 * a single rail would have to be measured around the bands that cover it, and
 * that coupling is what made the homepage version fragile.
 */
interface Stop {
	title: string;
	/** What the student actually does. One line — the map stays a map, and the
	 *  page it links to carries the reasoning. */
	does: string;
	/** e.g. "80 marks". Omitted for steps that carry none. */
	marks?: string;
	/**
	 * Internal target as a content slug — `stage_1/task_0/instruction`.
	 *
	 * Not a relative `./page.mdx` path: the remark plugin that rewrites those
	 * only ever sees markdown link nodes, and a URL passed in as a prop is not
	 * one. It would ship verbatim and 404. Resolved against the base here
	 * instead, the same way the sidebar and the progress store do it.
	 */
	slug?: string;
	/** Heading on that page to land on. */
	hash?: string;
	/** Absolute URL leaving the site — rendered with an outbound arrow. Use
	 *  instead of `slug`, not alongside it. */
	href?: string;
	/** Rough time cost, so the week can be planned. */
	time?: string;
}

interface Leg {
	place: 'local' | 'portal';
	label: string;
	/** Sets the scene for the whole band. */
	note: string;
	/** Marker shown above this band, naming the move that gets you here. Per
	 *  band rather than one for the journey, because Task 0 crosses the boundary
	 *  more than once and each crossing is a different move. */
	crossing?: string;
	stops: Stop[];
}

interface Props {
	legs: Leg[];
}

const { legs } = Astro.props;

/** A slug becomes a base-prefixed page URL; an explicit href is left alone. */
function urlFor(stop: Stop): string | undefined {
	if (stop.href) return stop.href;
	if (!stop.slug) return undefined;
	const base = import.meta.env.BASE_URL.replace(/\/$/, '');
	return `${base}/${stop.slug}/${stop.hash ? '#' + stop.hash : ''}`;
}

/* Numbering runs across the whole journey, not per band — the point is that it
   is one sequence that happens to move between two places. */
let counter = 0;
const numbered = legs.map((leg) => ({
	...leg,
	stops: leg.stops.map((stop) => ({
		...stop,
		n: ++counter,
		url: urlFor(stop),
		/* Only an explicit href leaves the site, so the outbound arrow follows
		   from that rather than from a flag an author has to remember to set. */
		out: Boolean(stop.href),
	})),
}));
---

<section class="journey not-content" data-journey>
	{
		numbered.map((leg) => (
			<>
				{leg.crossing && (
					<div class={`journey__cross journey__cross--${leg.place}`} data-reveal>
						<svg class="journey__cross-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="4" x2="12" y2="19"></line><polyline points="6 13 12 19 18 13"></polyline></svg>
						<p class="journey__cross-text">{leg.crossing}</p>
					</div>
				)}

				<section class={`journey__leg journey__leg--${leg.place}`} data-leg>
					<header class="journey__leg-head" data-reveal>
						<span class="journey__place">
							{leg.place === 'portal' ? (
								<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
							) : (
								<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
							)}
							{leg.label}
						</span>
						<p class="journey__leg-note">{leg.note}</p>
					</header>

					{/* The rail belongs to the run of stops, not to the band. Hung off
					    the band it also spanned the header above the first stop, which
					    put a length of line beside the band's own title with no node on
					    it — a line that appears to come from nowhere and go nowhere. */}
					<div class="journey__track">
						<div class="journey__rail" aria-hidden="true" data-rail></div>

						<ol class="journey__stops">
						{leg.stops.map((stop, i) => (
							<li class="journey__stop" data-item data-reveal style={`--delay:${i * 70}ms`}>
								<span class="journey__node" data-node aria-hidden="true">{stop.n}</span>

								<div class="journey__card">
									<div class="journey__card-head">
										<h4 class="journey__title">
											{stop.url ? (
												<a
													href={stop.url}
													target={stop.out ? '_blank' : undefined}
													rel={stop.out ? 'noopener noreferrer' : undefined}
												>
													{stop.title}
													{stop.out && (
														<svg class="journey__out" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="9 7 17 7 17 15"></polyline></svg>
													)}
												</a>
											) : (
												stop.title
											)}
										</h4>
										<span class="journey__meta">
											{stop.marks && <span class="journey__marks">{stop.marks}</span>}
											{stop.time && <span class="journey__time">{stop.time}</span>}
										</span>
									</div>

									<p class="journey__does">{stop.does}</p>
								</div>
							</li>
							))}
						</ol>
					</div>
				</section>
			</>
		))
	}
</section>

<style>
.journey {
	--node: 2rem;
	--node-top: 0.55rem;
	--rail-x: 1rem; /* rail centre, measured from the stop list's inline start */

	display: grid;
	gap: 0;
	margin: 1.75rem 0 2.5rem;
}

/* ── Reveal ──
   Same treatment as the homepage story so the two read as one system. The
   stagger is small on purpose: this is a flow to be understood, not a sequence
   to be watched, and a long cascade makes the reader wait on the animation.

   Gated behind `is-animated`, which only the script adds. Hiding by default
   would mean a script that never runs — an error, a blocked bundle, an old
   browser — leaves the entire flow map invisible, and this is the one thing on
   the page a student most needs to see. */
.journey.is-animated [data-reveal] {
	opacity: 0;
	translate: 0 18px;
	transition: opacity 0.5s ease, translate 0.5s ease;
	transition-delay: var(--delay, 0ms);
}

.journey.is-animated [data-reveal].is-in {
	opacity: 1;
	translate: 0 0;
}

/* ── Territory band ── */
.journey__leg {
	position: relative;
	padding: 1.1rem 1.25rem 1.2rem;
	border: 1px solid var(--t-border);
	border-radius: 0.85rem;
	background: rgb(var(--t-surface-2-rgb));
	transition: border-color 0.4s ease;
}

/* The portal band is drawn as somewhere else: dashed, so it reads as outside
   the boundary of everything above it, and tinted with the accent it is a
   destination for. */
.journey__leg--portal {
	border-style: dashed;
	border-color: var(--t-border-strong);
	background: linear-gradient(
		180deg,
		rgba(var(--t-accent-rgb), 0.07) 0%,
		rgb(var(--t-surface-2-rgb)) 70%
	);
}

.journey__leg.is-active {
	border-color: var(--t-accent);
}

.journey__leg-head {
	margin-block-end: 1rem;
}

.journey__place {
	display: inline-flex;
	align-items: center;
	gap: 0.4rem;
	font-family: var(--t-font-mono);
	font-size: 0.72rem;
	font-weight: 600;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--t-accent);
}

.journey__leg-note {
	margin: 0.4rem 0 0;
	font-size: 0.88rem;
	line-height: 1.6;
	color: var(--t-text-muted);
}

/* ── The crossing ── */
.journey__cross {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 0.55rem;
	padding: 0.9rem 1rem;
	color: var(--t-accent);
}

.journey__cross-text {
	margin: 0;
	font-family: var(--t-font-mono);
	font-size: 0.75rem;
	letter-spacing: 0.04em;
	text-align: center;
	color: var(--t-accent);
}

/* Going out to the portal is the crossing that matters, so it keeps the accent.
   Coming back to your own machine is routine and reads quieter — otherwise
   four equally loud markers teach the reader to ignore all of them. */
.journey__cross--local,
.journey__cross--local .journey__cross-text {
	color: var(--t-text-faint);
}

/* A short, slow bob — enough to read as "onward" without becoming something
   that moves in the corner of your eye while you are trying to read. */
.journey__cross-arrow {
	flex-shrink: 0;
	animation: journeyBob 2.4s ease-in-out infinite;
}

@keyframes journeyBob {
	0%, 100% { translate: 0 -2px; }
	50%      { translate: 0 3px; }
}

/* ── Rail ──
   Positioned against the stops, so it starts at the first node's centre rather
   than at the top of the band. The end is trimmed to the last node's centre by
   the script, which is the only part that needs measuring — card heights are
   not knowable here. Until then it runs to the foot of the last card, which is
   a slightly long line rather than a misplaced one. */
.journey__track {
	position: relative;
}

.journey__rail {
	position: absolute;
	inset-block: calc(var(--node-top) + var(--node) / 2) 0;
	inset-inline-start: var(--rail-x);
	/* --rail-x is the node centre, and the line is 2px wide — without this it
	   sits a pixel to the right of every number it threads through. */
	translate: -1px 0;
	inline-size: 2px;
	border-radius: 2px;
	z-index: 0;
	pointer-events: none;
	background: linear-gradient(
		to bottom,
		var(--t-accent) 0,
		var(--t-accent) var(--journey-fill, 0%),
		var(--t-border) var(--journey-fill, 0%),
		var(--t-border) 100%
	);
	transition: background 0.12s linear;
}

/* ── Stops ── */
.journey__stops {
	position: relative;
	z-index: 1;
	display: grid;
	gap: 0.85rem;
	margin: 0;
	padding: 0;
	list-style: none;
}

.journey__stop {
	position: relative;
	padding-inline-start: calc(var(--node) + 0.9rem);
}

.journey__node {
	position: absolute;
	inset-block-start: var(--node-top);
	inset-inline-start: calc(var(--rail-x) - var(--node) / 2);
	z-index: 2;
	display: grid;
	place-items: center;
	inline-size: var(--node);
	block-size: var(--node);
	border-radius: 50%;
	/* Opaque, so the rail passes behind the number rather than through it. */
	background: rgb(var(--t-body-rgb));
	border: 1px solid var(--t-border);
	font-family: var(--t-font-mono);
	font-size: 0.78rem;
	font-variant-numeric: tabular-nums;
	color: var(--t-text-faint);
	transition: color 0.3s ease, border-color 0.3s ease, scale 0.3s ease;
}

.journey__stop.reached .journey__node {
	border-color: var(--t-accent);
	color: var(--t-accent);
	scale: 1.06;
}

.journey__card {
	padding: 0.7rem 0.9rem 0.8rem;
	border: 1px solid transparent;
	border-radius: 0.55rem;
	transition: border-color 0.3s ease, background 0.3s ease;
}

.journey__stop:hover .journey__card {
	border-color: var(--t-border);
	background: rgb(var(--t-body-rgb));
}

.journey__card-head {
	display: flex;
	flex-wrap: wrap;
	align-items: baseline;
	justify-content: space-between;
	gap: 0.2rem 0.75rem;
}

.journey h4.journey__title {
	margin: 0;
	font-family: var(--t-font-heading);
	font-size: 0.98rem;
	font-weight: 600;
	line-height: 1.4;
	color: var(--t-text-strong);
}

.journey__title a {
	display: inline-flex;
	align-items: center;
	gap: 0.3rem;
	color: var(--t-text-strong);
	text-decoration: none;
	border-bottom: 0;
}

.journey__title a:hover {
	color: var(--t-link);
	text-decoration: underline;
}

.journey__out {
	flex-shrink: 0;
	color: var(--t-accent);
}

.journey__meta {
	display: inline-flex;
	align-items: baseline;
	gap: 0.45rem;
	flex-shrink: 0;
}

.journey__marks {
	padding: 0.08rem 0.4rem;
	border: 1px solid var(--t-ok-border);
	border-radius: 0.3rem;
	background: var(--t-ok-bg);
	font-family: var(--t-font-mono);
	font-size: 0.68rem;
	white-space: nowrap;
	color: var(--t-ok-fg);
}

.journey__time {
	font-family: var(--t-font-mono);
	font-size: 0.7rem;
	white-space: nowrap;
	color: var(--t-text-faint);
}

.journey__does {
	margin: 0.35rem 0 0;
	font-size: 0.89rem;
	line-height: 1.6;
	color: var(--t-text);
}

/* The rail now sits inside the stops rather than the band, so narrowing the
   band's padding no longer needs a matching correction on the rail. */
@media (max-width: 520px) {
	.journey__leg {
		padding-inline: 0.9rem;
	}
}

@media (prefers-reduced-motion: reduce) {
	/* The script declines to add `is-animated` in this case, so the reveal never
	   engages at all. Kept as a second line of defence against a stale class
	   surviving a view transition. */
	.journey.is-animated [data-reveal] {
		opacity: 1;
		translate: none;
		transition: none;
	}

	.journey__rail,
	.journey__node,
	.journey__card,
	.journey__leg {
		transition: none;
	}

	/* The bob is decoration with no state behind it, so it simply stops. */
	.journey__cross-arrow {
		animation: none;
	}

	.journey__stop.reached .journey__node {
		scale: 1;
	}
}
</style>

<script>
	/* Two behaviours, one scroll pass: reveal each element as it arrives, and
	   fill each band's rail as it goes by. Both are progressive — with the
	   script dead the reveal CSS never applies its `.is-in` and the rail stays
	   a plain line, so the flow still reads top to bottom. */
	function initJourney() {
		for (const root of document.querySelectorAll<HTMLElement>('[data-journey]')) {
			if (root.dataset.journeyReady) continue;
			root.dataset.journeyReady = '1';

			/* Reveal. Unobserved once shown: a flow map that re-animates every
			   time you scroll back up is a distraction, not a flourish.
			   Skipped entirely when motion is unwelcome or unsupported — the
			   markup is already visible, so declining to animate needs no
			   fallback of its own. */
			const targets = Array.from(root.querySelectorAll<HTMLElement>('[data-reveal]'));
			const animate =
				typeof IntersectionObserver === 'function' &&
				!(
					typeof window.matchMedia === 'function' &&
					window.matchMedia('(prefers-reduced-motion: reduce)').matches
				);

			if (animate) {
				root.classList.add('is-animated');

				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-in');
							io.unobserve(entry.target);
						}
					},
					{ threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
				);

				for (const el of targets) {
					/* Anything already on screen is marked in the same turn as the
					   class that hid it, so it never actually renders hidden. Without
					   this, the observer's first callback lands a frame later and the
					   top of the journey flickers on every load. */
					const box = el.getBoundingClientRect();
					if (box.top < window.innerHeight && box.bottom > 0) el.classList.add('is-in');
					else io.observe(el);
				}
			}

			const legs = Array.from(root.querySelectorAll<HTMLElement>('[data-leg]')).map((leg) => {
				const items = Array.from(leg.querySelectorAll<HTMLElement>('[data-item]'));
				return {
					leg,
					rail: leg.querySelector<HTMLElement>('[data-rail]'),
					track: leg.querySelector<HTMLElement>('.journey__track'),
					items,
					nodes: items.map((item) => item.querySelector<HTMLElement>('[data-node]')),
				};
			});

			/**
			 * Trims each rail to end at its last node's centre. CSS gets the top
			 * right on its own, but the bottom depends on how tall the final card
			 * is, which is only knowable once laid out — so the line otherwise
			 * runs on past the last number to the foot of the card.
			 */
			function measure() {
				for (const { rail, track, nodes } of legs) {
					if (!rail || !track) continue;
					const last = nodes[nodes.length - 1];
					if (!last) continue;

					const trackBox = track.getBoundingClientRect();
					const lastBox = last.getBoundingClientRect();
					const end = trackBox.bottom - (lastBox.top + lastBox.height / 2);
					rail.style.insetBlockEnd = Math.max(0, end).toFixed(2) + 'px';
				}
			}

			let ticking = false;

			function update() {
				/* Measured against a line 62% down the viewport — the same reference
				   the rest of the site's rails use, so a reader moving between pages
				   sees one consistent behaviour.
				   Taken from the rail rather than the band: the rail is what the fill
				   is drawn on, so measuring anything else lets the fill's leading edge
				   and the node it is supposed to be lighting drift apart. */
				const ref = window.innerHeight * 0.62;

				for (const { leg, rail, items, nodes } of legs) {
					if (!rail) continue;
					const box = rail.getBoundingClientRect();

					/* A band with one stop has a rail of no length — there is nothing to
					   draw between. Its node still has to light on the way past. */
					const progress =
						box.height === 0
							? ref >= box.top
								? 1
								: 0
							: Math.max(0, Math.min(1, (ref - box.top) / box.height));

					rail.style.setProperty('--journey-fill', (progress * 100).toFixed(2) + '%');
					leg.classList.toggle('is-active', progress > 0);

					const fillY = box.top + box.height * progress;
					for (let i = 0; i < items.length; i++) {
						const node = nodes[i];
						if (!node) continue;
						const r = node.getBoundingClientRect();
						items[i].classList.toggle('reached', r.top + r.height / 2 <= fillY);
					}
				}
			}

			function onScroll() {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					ticking = false;
					update();
				});
			}

			function onResize() {
				measure();
				onScroll();
			}

			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onResize, { passive: true });

			/* Re-measured once the webfonts land: they change card heights, and a
			   rail measured against the fallback face ends short of its last node. */
			document.fonts?.ready.then(onResize).catch(() => {});

			measure();
			update();
		}
	}

	initJourney();
	document.addEventListener('astro:page-load', initJourney);
</script>
