---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Spec {
  label: string;
  value: string;
}

interface Props {
  title?: string;
  specs: Spec[];
  image: ImageMetadata;
  alt?: string;
}

const { title, specs, image, alt = '' } = Astro.props;
---

<div class="infocard">
  <div class="infocard__info">
    {title && <p class="infocard__title">{title}</p>}
    <table class="infocard__table">
      <thead>
        <tr><th>Property</th><th>Value</th></tr>
      </thead>
      <tbody>
        {specs.map(s => (
          <tr>
            <td class="infocard__prop">{s.label}</td>
            <td class="infocard__val">{s.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="infocard__img">
    <Image src={image} alt={alt} />
  </div>
</div>

<style>
.infocard {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rem;
  flex-wrap: wrap;
}

.infocard__info {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.infocard__title {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--t-text-muted);
  margin: 0;
}

.infocard__table {
  border-collapse: separate;
  border-spacing: 0;
  border: 1px solid rgba(var(--t-line-rgb), 0.20);
  border-radius: 12px;
  overflow: hidden;
  font-size: 0.9rem;
  box-shadow: 0 4px 18px rgba(var(--t-line-rgb), 0.15), inset 0 1px 0 rgba(var(--t-raise-rgb), 0.45);
  background: rgba(var(--t-raise-rgb), 0.25);
}

.infocard__table thead {
  background: linear-gradient(180deg, rgba(var(--t-line-rgb), 0.25) 0%, rgba(var(--t-line-rgb), 0.12) 100%);
}

.infocard__table th {
  color: var(--t-text-strong);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.7rem 1.4rem;
  border-bottom: 1px solid rgba(var(--t-line-rgb), 0.30);
  text-align: left;
  white-space: nowrap;
}

.infocard__table td {
  padding: 0.65rem 1.4rem;
  border-bottom: 1px solid rgba(var(--t-line-rgb), 0.10);
  vertical-align: middle;
  white-space: nowrap;
}

.infocard__table tbody tr:last-child td {
  border-bottom: none;
}

.infocard__table tbody tr {
  transition: background 0.15s ease;
}

.infocard__table tbody tr:nth-child(even) td {
  background: rgba(var(--t-sand-rgb), 0.18);
}

.infocard__table tbody tr:hover td {
  background: rgba(var(--t-tint-rgb), 0.28);
}

.infocard__prop {
  color: var(--t-text-strong);
  font-weight: 500;
}

.infocard__val {
  color: var(--t-text-muted);
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.85rem;
}

.infocard__img {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.infocard__img img {
  max-height: 180px;
  width: auto;
  object-fit: contain;
  border-radius: 10px;
  filter: drop-shadow(0 6px 20px rgba(var(--t-line-rgb), 0.35));
  transition: transform 0.25s ease, filter 0.25s ease;
}

.infocard__img img:hover {
  transform: scale(1.04);
  filter: drop-shadow(0 8px 28px rgba(var(--t-line-rgb), 0.55));
}

@media (max-width: 640px) {
  .infocard {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>
