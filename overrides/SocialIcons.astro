---
/**
 * Header social links: eYantra GitHub repo, discussion forum and student
 * portal.
 *
 * Each link carries BOTH an icon and a text label, and the viewport decides
 * which one is shown:
 *   - narrow (< 50rem): the icon, so the row stays compact enough to leave
 *     the site title its full size. Three words here crowded the title out.
 *   - wide (>= 50rem): the text label, which is more legible and self-
 *     explanatory when there is room for it.
 * The hidden one of the pair is never `display: none`d away from assistive
 * tech — on mobile the label stays in the accessibility tree as the link's
 * accessible name (visually-hidden, not removed), and the icon is
 * aria-hidden. So the link is always properly named at every width.
 *
 * The GitHub URL is read from `social:` in astro.config.mjs to keep one
 * source of truth, falling back to the plugin's `links.github`; its icon comes
 * from Starlight's own icon set. The forum and portal aren't part of
 * Starlight's `social` schema, so their URLs come from the plugin options and
 * their icons are defined here:
 *   - the forum uses a monochrome, currentColor "forum" mark (two
 *     overlapping message bubbles) that follows the same accent/hover
 *     colours (and light/dark switching) as the built-in social icons.
 *   - the portal uses the real two-tone eYantra brand mark, which `social:`
 *     can't render (it only supports single-colour icons).
 */
import { Icon } from '@astrojs/starlight/components';
import config from 'virtual:starlight/user-config';
import site from 'virtual:mdbook-style/config';

/* Optional on both sides now that this ships as a theme: a site with no
   repository link drops the icon rather than crashing the header on a `!`
   that no longer holds. */
const GITHUB_URL =
	config.social?.find((link) => link.icon === 'github')?.href ?? site.links.github;
const FORUM_URL = site.links.forum;
const PORTAL_URL = site.links.portal;
---

{GITHUB_URL && (
<a href={GITHUB_URL} rel="me noopener noreferrer" target="_blank" class="sl-flex eyantra-social-link">
	<Icon name="github" class="eyantra-social-icon" />
	<span class="eyantra-social-label">GitHub</span>
</a>
)}

<a href={FORUM_URL} rel="me noopener noreferrer" target="_blank" class="sl-flex eyantra-social-link">
	<svg class="eyantra-social-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path
			d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"
		></path>
		<path
			d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1"
		></path>
	</svg>
	<span class="eyantra-social-label">Forum</span>
</a>

<a href={PORTAL_URL} rel="me noopener noreferrer" target="_blank" class="sl-flex eyantra-social-link eyantra-portal">
	<svg class="eyantra-social-icon" aria-hidden="true" viewBox="0 0 403.2 440.51">
		<path
			fill="#E13236"
			d="M402.69 292.76c0.87,-34.21 0.45,-69.84 0,-104.91l0 -124.43c0,-10.38 -2.74,-20.18 -7.54,-28.71 -16.94,-44.96 -75.22,-33.38 -275.91,-33.35 -142.9,0.02 -117.49,-0.19 -117.49,290.07 0,174.46 -13.7,147.45 254.88,147.45 47.34,0 125.52,13.88 141.46,-39.32 2.96,-6.99 4.6,-14.66 4.6,-22.7l0 -84.1z"
		></path>
		<path
			fill="#FEFEFE"
			d="M329.89 188.04l0 -39.99c0.15,-18.61 -2.67,-34.3 -8.29,-46.97 -5.53,-12.41 -14.35,-21.99 -26.21,-28.42 -11.85,-6.48 -27.12,-9.8 -46,-9.8l-94.97 0c-18.21,0 -33.63,2.95 -46.49,8.48 -12.81,5.87 -22.57,14.77 -29.4,26.66 -6.91,11.94 -10.27,27.27 -10.27,46.3l0 150.33c-0.16,9.51 0.5,18.3 1.68,26.24 1.38,8.06 3.9,15.34 7.72,22.43 3.94,6.96 9.56,13.67 17.01,19.87 6.52,5.51 13.14,9.45 19.87,11.93 6.76,2.67 13.86,4.19 21.16,5.04 7.45,0.72 15.36,0.96 23.62,0.9l243.76 0 0 -54.64 -233.57 0c-4.39,0.16 -8.48,0 -12.03,0 -3.51,-0.38 -7.05,-0.86 -10.51,-2.14 -3.31,-0.97 -6.53,-2.9 -10.22,-5.39 -4.12,-3.34 -7.15,-6.78 -9.23,-10.35 -2.04,-3.58 -3.12,-7.52 -3.67,-11.76 -0.63,-4.13 -1.02,-8.91 -0.87,-14.24l0 -9.34 206.91 -85.14zm-55.25 -30.48l0 0 -152.23 62.97 0 -62.97c0,-10.3 2.19,-18.47 6.74,-24.36 4.29,-6.06 10.21,-10.11 17.75,-12.67 7.37,-2.35 15.81,-3.75 25.13,-3.51l59.82 0c7.93,-0.24 15.23,0.98 21.67,3.16 6.37,2.3 11.48,5.99 15.36,11.27 3.72,5.14 5.59,12.12 5.76,21.02l0 5.09z"
		></path>
	</svg>
	<span class="eyantra-social-label">Portal</span>
</a>

<style>
	@layer starlight.core {
		/* 0.3em of padding around a 1em glyph gives a ~26px tap target — over
		   the 24px WCAG 2.2 minimum, and as much as the phone header can spare
		   now that the theme switch shares this row (see the mobile block in
		   custom.css). Starlight's own links use 0.5em with `margin: -0.5em`;
		   the negative margin is deliberately NOT copied, since it cancels the
		   padding so the box stops occupying the space it covers, and at a
		   tightened header gap the tap targets overlap by ~10px and a tap
		   between two icons can hit the wrong link. Real padding keeps them
		   tiled. This value applies on phones only — the ≥50rem block below
		   replaces it once the links become text labels. */
		.eyantra-social-link {
			padding: 0.3em;
			align-items: center;
			color: var(--sl-color-text-accent);
		}

		.eyantra-social-link:hover {
			color: var(--sl-color-white);
		}

		.eyantra-social-icon {
			width: 1em;
			height: 1em;
			display: block;
		}

		/* The portal mark is a fixed two-tone brand logo, not a currentColor
		   icon, so its hover is a subtle fade rather than a colour swap. Scoped
		   to the icon: once the text label takes over on wide screens, the
		   label should still get the normal colour hover. */
		.eyantra-portal .eyantra-social-icon {
			opacity: 0.85;
			transition: opacity 0.15s ease;
		}

		.eyantra-portal:hover .eyantra-social-icon {
			opacity: 1;
		}

		/* Mobile default: the label is the link's accessible name but is not
		   painted — visually-hidden rather than `display: none`, which would
		   drop it from the accessibility tree and leave the link unnamed. */
		.eyantra-social-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		/* Wide screens: text takes over, icon steps aside. Small-caps eyebrow
		   treatment, matching the "On this page" heading and timeline card
		   tags elsewhere on the site, so it reads as a designed nav element
		   rather than a bare underlined hyperlink. */
		@media (min-width: 50rem) {
			.eyantra-social-icon {
				display: none;
			}

			.eyantra-social-label {
				position: static;
				width: auto;
				height: auto;
				overflow: visible;
				clip-path: none;
			}

			.eyantra-social-link {
				padding: 0.35rem 0.5rem;
				margin: 0;
				border-radius: 999px;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				text-decoration: none;
				transition: background-color 0.15s ease, color 0.15s ease;
			}

			.eyantra-social-link:hover,
			.eyantra-social-link:focus-visible {
				background: rgba(var(--t-accent-rgb), 0.14);
			}
		}
	}
</style>
