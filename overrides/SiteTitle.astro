---
/**
 * Header brand lockup: the site title followed by the eYantra mark.
 *
 * Overrides Starlight's own SiteTitle. Everything above the eYantra block is
 * carried over from the default component unchanged, so a `logo:` added to
 * astro.config.mjs later still behaves exactly as Starlight documents it.
 *
 * The mark sits *inside* the title's <a>, not after it. An anchor cannot
 * contain another anchor, and the header title slot is a single link to the
 * site root — so the logo is decorative here (aria-hidden; the link is
 * already named by the title text) rather than a second link to eyantra.org.
 * The clickable eYantra portal link lives in SocialIcons.astro on the far
 * right of the same bar.
 */
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
import site from 'virtual:mdbook-style/config';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{
		config.logo && logos.dark && (
			<>
				<img
					class:list={{ 'light:sl-hidden print:hidden': !('src' in config.logo) }}
					alt={config.logo.alt}
					src={logos.dark.src}
					width={logos.dark.width}
					height={logos.dark.height}
				/>
				{/* Show light alternate if a user configure both light and dark logos. */}
				{!('src' in config.logo) && (
					<img
						class="dark:sl-hidden print:block"
						alt={config.logo.alt}
						src={logos.light?.src}
						width={logos.light?.width}
						height={logos.light?.height}
					/>
				)}
			</>
		)
	}
	{/* One SVG for both themes rather than two hidden copies: the two fills are
	    driven by custom properties that the theme blocks below re-point, so
	    there is no duplicated path data and nothing to keep in sync. A site
	    outside eYantra turns it off with `brand.mark: false`. */}
	{site.brand.mark && (
	<svg class="ey-mark" aria-hidden="true" viewBox="0 0 403.2 440.51">
		<path
			fill="var(--ey-mark-bg)"
			d="M402.69 292.76c0.87,-34.21 0.45,-69.84 0,-104.91l0 -124.43c0,-10.38 -2.74,-20.18 -7.54,-28.71 -16.94,-44.96 -75.22,-33.38 -275.91,-33.35 -142.9,0.02 -117.49,-0.19 -117.49,290.07 0,174.46 -13.7,147.45 254.88,147.45 47.34,0 125.52,13.88 141.46,-39.32 2.96,-6.99 4.6,-14.66 4.6,-22.7l0 -84.1z"
		></path>
		<path
			fill="var(--ey-mark-fg)"
			d="M329.89 188.04l0 -39.99c0.15,-18.61 -2.67,-34.3 -8.29,-46.97 -5.53,-12.41 -14.35,-21.99 -26.21,-28.42 -11.85,-6.48 -27.12,-9.8 -46,-9.8l-94.97 0c-18.21,0 -33.63,2.95 -46.49,8.48 -12.81,5.87 -22.57,14.77 -29.4,26.66 -6.91,11.94 -10.27,27.27 -10.27,46.3l0 150.33c-0.16,9.51 0.5,18.3 1.68,26.24 1.38,8.06 3.9,15.34 7.72,22.43 3.94,6.96 9.56,13.67 17.01,19.87 6.52,5.51 13.14,9.45 19.87,11.93 6.76,2.67 13.86,4.19 21.16,5.04 7.45,0.72 15.36,0.96 23.62,0.9l243.76 0 0 -54.64 -233.57 0c-4.39,0.16 -8.48,0 -12.03,0 -3.51,-0.38 -7.05,-0.86 -10.51,-2.14 -3.31,-0.97 -6.53,-2.9 -10.22,-5.39 -4.12,-3.34 -7.15,-6.78 -9.23,-10.35 -2.04,-3.58 -3.12,-7.52 -3.67,-11.76 -0.63,-4.13 -1.02,-8.91 -0.87,-14.24l0 -9.34 206.91 -85.14zm-55.25 -30.48l0 0 -152.23 62.97 0 -62.97c0,-10.3 2.19,-18.47 6.74,-24.36 4.29,-6.06 10.21,-10.11 17.75,-12.67 7.37,-2.35 15.81,-3.75 25.13,-3.51l59.82 0c7.93,-0.24 15.23,0.98 21.67,3.16 6.37,2.3 11.48,5.99 15.36,11.27 3.72,5.14 5.59,12.12 5.76,21.02l0 5.09z"
		></path>
	</svg>
	)}

	<span class:list={{ 'sr-only': config.logo?.replacesTitle }} translate="no">
		{siteTitle}
	</span>
</a>

<style>
	@layer starlight.core {
		/* Unchanged from Starlight's SiteTitle. */
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		span {
			overflow: hidden;
		}
		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
		}

		/* Sized in `em` so it tracks the title text rather than the nav box —
		   the two then stay optically paired at every breakpoint, including
		   the phone header where custom.css shrinks the title. `flex-shrink:0`
		   because the title span is the element allowed to truncate; without
		   it a long title squashes the mark instead of ellipsing itself. */
		.ey-mark {
			height: 1.15em;
			width: auto;
			flex-shrink: 0;
			display: block;
			/* Pulls the title closer than --sl-nav-gap, which is tuned for the
			   spacing *between* header regions and reads as a gap rather than
			   a lockup at this size. `-end` because the mark leads the title. */
			margin-inline-end: calc(var(--sl-nav-gap) * -0.35);
		}

		/* Android/white nav (#FFFFFF): the official two-tone mark. */
		.ey-mark {
			--ey-mark-bg: #e13236;
			--ey-mark-fg: #fefefe;
		}

		/* Near-black nav (#121212): #E13236 is a mid-red that goes muddy and
		   loses its edge against near-black, so the box is lifted in lightness
		   while holding the brand hue. The glyph stays white — it is knocked
		   out of the box, so it tracks the box, not the page. */
		:global([data-theme='dark']) .ey-mark {
			--ey-mark-bg: #ff4e52;
			--ey-mark-fg: #ffffff;
		}

		/* The mark is a fixed brand asset, not a currentColor icon, so it gets
		   the same subtle fade-on-hover as the portal mark in SocialIcons
		   rather than a colour swap. */
		.ey-mark {
			opacity: 0.9;
			transition: opacity 0.15s ease;
		}
		.site-title:hover .ey-mark {
			opacity: 1;
		}
	}
</style>
